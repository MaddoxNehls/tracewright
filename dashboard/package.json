{
  "name": "@tracewright/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "deps:build": "pnpm --dir ../packages/run-diff install --frozen-lockfile && pnpm --dir ../packages/run-diff build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "prebuild": "pnpm run deps:build",
    "pretypecheck": "pnpm run deps:build",
    "pretest": "pnpm run deps:build",
    "predev": "pnpm run deps:build"
  },
  "dependencies": {
    "@tracewright/run-diff": "link:../packages/run-diff",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.0.9"
}
