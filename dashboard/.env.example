# Postgres the dashboard reads from. Default matches docker-compose at the repo root.
DATABASE_URL=postgres://tracewright:tracewright@localhost:5442/tracewright

# Optional: GitHub OAuth for private projects. Without these the app runs read-only
# with public projects only, and the sign-in button is disabled.
# AUTH_SECRET=   # openssl rand -base64 32
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
